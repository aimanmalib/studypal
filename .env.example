# StudyPal environment. Copy to .env.local and edit.
#
# Leave every key empty to run in bring-your-own-key mode: each visitor
# adds their own key in Settings (stored only in their browser).
# Setting a key switches to self-host mode: the server key is used for
# every request and browser settings are ignored.

# Preset: openai | openrouter | groq | deepseek | together | mistral | mimo | ollama | llamacpp
LLM_PROVIDER=openai

# Key for the provider above (or use its own variable, e.g. OPENAI_API_KEY).
LLM_API_KEY=

# Optional overrides
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://my-proxy.example/v1
# LLM_MAX_TOKENS=2048

# Private self-hosted instances only: lets browser Settings use Ollama /
# llama.cpp and custom endpoint URLs. Never enable on a public server.
# LLM_ALLOW_CUSTOM_BASE_URL=1
